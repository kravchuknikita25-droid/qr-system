<!DOCTYPE html>
<html>
<head>
    <title>Редактирование QR</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container mt-5">

    <div class="card mx-auto" style="max-width:600px">

        <div class="card-body">

            <h2>Редактировать QR</h2>

            <form method="POST">

                <div class="mb-3">

                    <label>Название</label>

                    <input
                        type="text"
                        name="title"
                        value="<%= qr.title %>"
                        class="form-control"
                        required
                    >

                </div>

                <div class="mb-3">

                    <label>URL</label>

                    <input
                        type="text"
                        name="url"
                        value="<%= qr.url %>"
                        class="form-control"
                        required
                    >

                </div>

                <button class="btn btn-primary">
                    Сохранить
                </button>

            </form>

        </div>

    </div>

</div>

</body>
</html>