<!DOCTYPE html>

<html lang="ru">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Статистика</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

body{
    background:#f5f7fb;
    font-family:Arial,sans-serif;
}

.stat-card{
    border:none;
    border-radius:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.chart-card{
    border:none;
    border-radius:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.table-card{
    border:none;
    border-radius:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.small-pie{
    width:280px;
    height:280px;
    margin:auto;
}

.page-title{
    font-weight:700;
}

</style>

</head>

<body>

<div class="container-fluid p-4">


<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="page-title">
            Аналитика QR-кодов
        </h2>

        <small class="text-muted">
            Подробная статистика переходов
        </small>

    </div>

    <a href="/dashboard"
       class="btn btn-secondary">

        <i class="bi bi-arrow-left"></i>

        Dashboard

    </a>

</div>

<div class="row mb-4">

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Всего переходов</h6>

                <h2>
                    <%= totalClicks %>
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>QR-кодов</h6>

                <h2>
                    <%= qrCodes.length %>
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Активных ссылок</h6>

                <h2>
                    <%= qrCodes.length %>
                </h2>

            </div>

        </div>

    </div>

</div>

<div class="card chart-card mb-4">

    <div class="card-body">

        <h4 class="mb-3">

            <i class="bi bi-graph-up"></i>

            Переходы по дням

        </h4>

        <canvas id="lineChart"></canvas>

    </div>

</div>

<div class="card chart-card mb-4">

    <div class="card-body text-center">

        <h4 class="mb-4">

            <i class="bi bi-pie-chart"></i>

            Источники переходов

        </h4>

        <div class="small-pie">

            <canvas id="sourceChart"></canvas>

        </div>

    </div>

</div>

<div class="card table-card">

    <div class="card-body">

        <h4 class="mb-3">

            <i class="bi bi-table"></i>

            QR-коды

        </h4>

        <table class="table table-hover">

            <thead>

            <tr>

                <th>Название</th>
                <th>Ссылка</th>
                <th>Клики</th>

            </tr>

            </thead>

            <tbody>

            <% qrCodes.forEach(qr => { %>

            <tr>

                <td>
                    <%= qr.title %>
                </td>

                <td>
                    <%= qr.url %>
                </td>

                <td>
                    <%= qr.clicks %>
                </td>

            </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>


</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const labels = [
<% visits.forEach(v => { %>
"<%= v.visit_date %>",
<% }) %>
];

const data = [
<% visits.forEach(v => { %>
<%= v.clicks %>,
<% }) %>
];

new Chart(
document.getElementById("lineChart"),
{
    type:"line",

    data:{
        labels:labels,

        datasets:[{

            label:"Переходы",

            data:data,

            tension:0.4,

            fill:false

        }]
    },

    options:{

        responsive:true,

        plugins:{
            legend:{
                display:true
            }
        },

        scales:{

            y:{
                beginAtZero:true
            }

        }

    }

}
);

</script>

<script>

const sourceLabels = [
<% sources.forEach(source => { %>
"<%= source.source %>",
<% }) %>
];

const sourceData = [
<% sources.forEach(source => { %>
<%= source.total %>,
<% }) %>
];

new Chart(
document.getElementById("sourceChart"),
{
    type:"pie",

    data:{
        labels:sourceLabels,

        datasets:[{

            data:sourceData

        }]
    },

    options:{
        responsive:true
    }
}
);

</script>

</body>
</html>
