<!DOCTYPE html>

<html lang="ru">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

body{
    background:#f5f7fb;
    margin:0;
    font-family:Arial,sans-serif;
}

.sidebar{
    width:250px;
    height:100vh;
    position:fixed;
    left:0;
    top:0;
    color:white;
    padding:25px;
    background:linear-gradient(
        180deg,
        #2d1b69,
        #5b3df5
    );
}

.sidebar h3{
    margin-bottom:20px;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:12px;
    margin-bottom:10px;
    border-radius:10px;
    transition:.3s;
}

.sidebar a:hover{
    background:rgba(255,255,255,.15);
}

.sidebar i{
    margin-right:10px;
}

.main{
    margin-left:250px;
    padding:30px;
}

.topbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:25px;
}

.stat-card{
    border:none;
    border-radius:20px;
    background:white;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.card-shadow{
    box-shadow:0 5px 20px rgba(0,0,0,.08);
    border:none;
    border-radius:20px;
}

.table-card{
    border:none;
    border-radius:20px;
}

.table td{
    vertical-align:middle;
}

.table thead{
    background:#f8f9ff;
}

.user-box{
    background:white;
    padding:10px 15px;
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.05);
}

.quick-btn{
    border-radius:12px;
}

</style>

</head>

<body>

<div class="sidebar">


<h3>QR Link</h3>

<hr>

<a href="/dashboard">
    <i class="bi bi-house"></i>
    Главная
</a>

<a href="/dashboard">
    <i class="bi bi-qr-code"></i>
    Мои QR-коды
</a>

<a href="/create">
    <i class="bi bi-plus-circle"></i>
    Создать QR
</a>

<a href="/stats">
    <i class="bi bi-bar-chart"></i>
    Статистика
</a>

<a href="/profile">
    <i class="bi bi-person"></i>
    Профиль
</a>

<a href="/settings">
    <i class="bi bi-gear"></i>
    Настройки
</a>

<% if(user.is_admin){ %>

<a href="/admin">
    <i class="bi bi-shield-lock"></i>
    Админ панель
</a>

<% } %>

<a href="/logout">
    <i class="bi bi-box-arrow-right"></i>
    Выход
</a>


</div>

<div class="main">


<div class="topbar">

    <div>
        <h2>Главная</h2>
        <small>
            Добро пожаловать,
            <%= user.email %>
        </small>
    </div>

    <div class="user-box">

        <i class="bi bi-bell"></i>

        <span class="ms-3">
            <%= user.email %>
        </span>

    </div>

</div>

<div class="row mb-4">

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Всего QR-кодов</h6>

                <h2>
                    <%= totalQr %>
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Переходов</h6>

                <h2>
                    <%= totalClicks %>
                </h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Активные ссылки</h6>

                <h2>
                    <%= activeLinks %>
                </h2>

            </div>

        </div>

    </div>

</div>

<div class="card card-shadow mb-4">

    <div class="card-body">

        <h5 class="mb-3">
            Переходы по QR-кодам
        </h5>

        <canvas id="clickChart"></canvas>

    </div>

</div>

<div class="card card-shadow mb-4">

    <div class="card-body">

        <h5 class="mb-3">
            Последние QR-коды
        </h5>

        <% qrCodes.slice(0,3).forEach(qr => { %>

        <div class="d-flex justify-content-between border-bottom py-2">

            <div>

                <strong>
                    <%= qr.title %>
                </strong>

                <br>

                <small>
                    qr.link/<%= qr.id %>
                </small>

            </div>

            <div>

                <strong>
                    <%= qr.clicks %>
                </strong>

            </div>

        </div>

        <% }) %>

    </div>

</div>

<div class="card table-card card-shadow">

    <div class="card-header bg-white">

        <strong>
            Мои QR-коды
        </strong>

    </div>

    <div class="card-body">

        <table class="table table-hover">

            <thead>

            <tr>
                <th>Название</th>
                <th>Ссылка</th>
                <th>QR Link</th>
                <th>Клики</th>
                <th>Действия</th>
            </tr>

            </thead>

            <tbody>

            <% qrCodes.forEach(qr => { %>

            <tr>

                <td><%= qr.title %></td>

                <td><%= qr.url %></td>

                <td>

                    <a href="/r/<%= qr.id %>" target="_blank">

                        /r/<%= qr.id %>

                    </a>

                </td>

                <td><%= qr.clicks %></td>

                <td>

                    <a href="/edit/<%= qr.id %>"
                       class="btn btn-warning btn-sm">
                       ✏️
                    </a>

                    <a href="/download/png/<%= qr.id %>"
                       class="btn btn-success btn-sm">
                       PNG
                    </a>

                    <a href="/download/svg/<%= qr.id %>"
                       class="btn btn-info btn-sm">
                       SVG
                    </a>

                    <a href="/delete/<%= qr.id %>"
                       class="btn btn-danger btn-sm">
                       🗑
                    </a>

                </td>

            </tr>

            <% }) %>

            </tbody>

        </table>

        <a href="/create"
           class="btn btn-primary quick-btn">
            + Создать QR
        </a>

        <a href="/stats"
           class="btn btn-success quick-btn">
            Статистика
        </a>

    </div>

</div>


</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

const labels = [
<% qrCodes.forEach(qr => { %>
"<%= qr.title %>",
<% }) %>
];

const data = [
<% qrCodes.forEach(qr => { %>
<%= qr.clicks %>,
<% }) %>
];

new Chart(
document.getElementById("clickChart"),
{
    type:"line",

    data:{
        labels:labels,

        datasets:[{
            label:"Переходы",
            data:data,
            tension:0.4,
            fill:false
        }]
    },

    options:{
        responsive:true
    }
}
);

</script>

</body>
</html>
