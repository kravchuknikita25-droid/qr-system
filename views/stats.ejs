<!DOCTYPE html>
<html lang="ru">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Статистика</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

body{
    background:#f5f7fb;
}

.stat-card{
    border:none;
    border-radius:15px;
    box-shadow:0 4px 15px rgba(0,0,0,.08);
}

.chart-box{
    height:320px;
}

.pie-box{
    width:260px;
    height:260px;
    margin:auto;
}

</style>

</head>

<body>

<div class="container mt-4">

    <h1 class="mb-4">
        Аналитика QR-кодов
    </h1>

    <!-- Карточки -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h6>Всего переходов</h6>
                    <h2><%= totalClicks %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h6>QR-кодов</h6>
                    <h2><%= qrCodes.length %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h6>Активных ссылок</h6>
                    <h2><%= qrCodes.length %></h2>
                </div>
            </div>
        </div>

    </div>

    <!-- ЛИНИЯ (ПЕРЕХОДЫ ПО ДНЯМ) -->
    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

    <h4>
        Переходы по дням
    </h4>

    <form method="GET" action="/stats">

        <div class="d-flex align-items-center">

            <span class="me-2">
                Период
            </span>

            <select
                name="period"
                class="form-select"
                onchange="this.form.submit()"
            >

                <option
                    value="1"
                    <%= period=="1" ? "selected" : "" %>>
                    1 день
                </option>

                <option
                    value="7"
                    <%= period=="7" ? "selected" : "" %>>
                    7 дней
                </option>

                <option
                    value="30"
                    <%= period=="30" ? "selected" : "" %>>
                    Месяц
                </option>

            </select>

        </div>

    </form>

</div>

            <div class="chart-box">
                <canvas id="lineChart"></canvas>
            </div>

        </div>

    </div>

    <!-- КРУГОВАЯ ДИАГРАММА -->
    <div class="card mb-4">

        <div class="card-body">

            <h4 class="text-center">Источники переходов</h4>

            <div class="pie-box">
                <canvas id="sourceChart"></canvas>
            </div>

        </div>

    </div>

    <!-- ТАБЛИЦА -->
    <div class="card">

        <div class="card-body">

            <h4>QR-коды</h4>

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Ссылка</th>
                        <th>Клики</th>
                    </tr>
                </thead>

                <tbody>

                <% qrCodes.forEach(qr => { %>

                    <tr>
                        <td><%= qr.title %></td>
                        <td><%= qr.url %></td>
                        <td><%= qr.clicks %></td>
                    </tr>

                <% }) %>

                </tbody>

            </table>

        </div>

    </div>

    <br>

    <a href="/dashboard" class="btn btn-secondary">
        Назад
    </a>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- ЛИНИЯ -->
<script>

const labels = [
<% visits.forEach(v => { %>
"<%= v.visit_date %>",
<% }) %>
];

const data = [
<% visits.forEach(v => { %>
<%= v.clicks %>,
<% }) %>
];

new Chart(
document.getElementById("lineChart"),
{
    type:"line",

    data:{
        labels:labels,
        datasets:[{
            label:"Переходы",
            data:data,
            borderWidth:3,
            tension:0.4,
            fill:false,
            pointRadius:4
        }]
    },

    options:{
        responsive:true,
        maintainAspectRatio:false,
        scales:{
            y:{ beginAtZero:true }
        }
    }
}
);

</script>

<!-- PIE -->
<script>

const sourceLabels = [
<% sources.forEach(s => { %>
"<%= s.source %>",
<% }) %>
];

const sourceData = [
<% sources.forEach(s => { %>
<%= s.total %>,
<% }) %>
];

new Chart(
document.getElementById("sourceChart"),
{
    type:"pie",

    data:{
        labels:sourceLabels,
        datasets:[{
            data:sourceData
        }]
    },

    options:{
        responsive:true,
        maintainAspectRatio:false
    }
}
);

</script>

</body>
</html>