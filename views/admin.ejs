<!DOCTYPE html>

<html lang="ru">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Админ панель</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<link rel="stylesheet"
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>

body{
    background:#f5f7fb;
    font-family:Arial,sans-serif;
}

.sidebar{
    width:250px;
    height:100vh;
    position:fixed;
    left:0;
    top:0;
    background:linear-gradient(180deg,#2d1b69,#5b3df5);
    color:white;
    padding:25px;
}

.sidebar a{
    display:block;
    color:white;
    text-decoration:none;
    padding:12px;
    margin-bottom:10px;
    border-radius:10px;
}

.sidebar a:hover{
    background:rgba(255,255,255,.15);
}

.main{
    margin-left:250px;
    padding:30px;
}

.stat-card{
    border:none;
    border-radius:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

.table-card{
    border:none;
    border-radius:20px;
    box-shadow:0 5px 20px rgba(0,0,0,.08);
}

</style>

</head>

<body>

<div class="sidebar">


<h3>Admin</h3>

<hr>

<a href="/dashboard">
    <i class="bi bi-house"></i>
    Dashboard
</a>

<a href="/admin">
    <i class="bi bi-people"></i>
    Пользователи
</a>

<a href="/logout">
    <i class="bi bi-box-arrow-right"></i>
    Выход
</a>


</div>

<div class="main">


<h2 class="mb-4">
    Админ панель
</h2>

<div class="row mb-4">

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Пользователей</h6>

                <h2><%= totalUsers %></h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>QR-кодов</h6>

                <h2><%= totalQr %></h2>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card stat-card">

            <div class="card-body">

                <h6>Переходов</h6>

                <h2><%= totalVisits %></h2>

            </div>

        </div>

    </div>

</div>

<div class="card table-card mb-4">

    <div class="card-body">

        <div class="d-flex justify-content-between mb-3">

            <h4>Пользователи</h4>

            <a
                href="/admin/create-user"
                class="btn btn-primary"
            >
                Создать пользователя
            </a>

        </div>

        <table class="table table-hover">

            <thead>

            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>

            </thead>

            <tbody>

            <% users.forEach(user => { %>

            <tr>

                <td><%= user.id %></td>

                <td><%= user.email %></td>

                <td>

                    <span class="badge bg-success">

                        <%= user.status || 'Активен' %>

                    </span>

                </td>

                <td>

                    <a
                        href="/admin/edit-user/<%= user.id %>"
                        class="btn btn-warning btn-sm"
                    >
                        Изменить
                    </a>

                    <a
                        href="/admin/block/<%= user.id %>"
                        class="btn btn-secondary btn-sm"
                    >
                        Блок
                    </a>

                    <a
                        href="/admin/delete-user/<%= user.id %>"
                        class="btn btn-danger btn-sm"
                    >
                        Удалить
                    </a>

                </td>

            </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>

<div class="card table-card">

    <div class="card-body">

        <h4 class="mb-3">
            Все QR-коды системы
        </h4>

        <table class="table table-hover">

            <thead>

            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Ссылка</th>
                <th>Клики</th>
            </tr>

            </thead>

            <tbody>

            <% qrCodes.forEach(qr => { %>

            <tr>

                <td><%= qr.id %></td>

                <td><%= qr.title %></td>

                <td><%= qr.url %></td>

                <td><%= qr.clicks %></td>

            </tr>

            <% }) %>

            </tbody>

        </table>

    </div>

</div>


</div>

</body>
</html>
