<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

<title>Dashboard</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
<body class="bg-light">

<nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <span class="navbar-brand">
            QR Management System
        </span>

        <div>

    <span class="text-white me-3">
        <%= user.email %>
    </span>

    <a
        href="/logout"
        class="btn btn-danger btn-sm"
    >
        Выход
    </a>

</div>
    </div>
</nav>

<div class="container mt-4">

    <h1 class="mb-4">
        Dashboard
    </h1>

    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>QR Codes</h5>
                    <h2><%= totalQr %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Переходы</h5>
                    <h2><%= totalClicks %></h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Активные ссылки</h5>
                    <h2><%= activeLinks %></h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card mt-4 shadow-sm">

        <div class="card-header">
            Мои QR-коды
        </div>

        <div class="card-body">

            <table class="table">

                <thead>
<tr>
    <th>Название</th>
    <th>Ссылка</th>
    <th>QR Link</th>
    <th>Клики</th>
    <th>Действие</th>
</tr>
</thead>

<tbody>

<% qrCodes.forEach(qr => { %>

<tr>

    <td><%= qr.title %></td>

    <td><%= qr.url %></td>

    <td>
        <a href="/q/<%= qr.id %>">
            /q/<%= qr.id %>
        </a>
    </td>

    <td><%= qr.clicks %></td>

    <td>
    <a
        href="/delete/<%= qr.id %>"
        class="btn btn-danger btn-sm"
    >
        Удалить
    </a>
</td>

</tr>

<% }) %>

</tbody>

            </table>

            <a href="/create" class="btn btn-primary">
    Создать QR
</a>
<a href="/stats" class="btn btn-success">
    Статистика
</a>
        </div>

    </div>

</div>

</body>
</html>